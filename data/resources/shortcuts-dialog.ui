<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="AdwShortcutsDialog" id="shortcuts_dialog">
    <child>
      <object class="AdwShortcutsSection">
        <property name="title" translatable="yes">General</property>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Pair Device</property>
            <property name="action-name">win.pair-device</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Rescan Devices</property>
            <property name="action-name">win.rescan</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Preferences</property>
            <property name="action-name">app.preferences</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Keyboard Shortcuts</property>
            <property name="action-name">app.shortcuts</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Close Window</property>
            <property name="action-name">window.close</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Quit</property>
            <property name="action-name">app.quit</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwShortcutsSection">
        <property name="title" translatable="yes">Mirroring Window</property>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Toggle Fullscreen</property>
            <property name="accelerator">&lt;Alt&gt;f F11</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Resize to Fit</property>
            <property name="accelerator">&lt;Alt&gt;w</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Resize to Original Size</property>
            <property name="accelerator">&lt;Alt&gt;g</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Home</property>
            <property name="accelerator">&lt;Alt&gt;h</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Back</property>
            <property name="accelerator">&lt;Alt&gt;b</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Recent Apps</property>
            <property name="accelerator">&lt;Alt&gt;s</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Power Button</property>
            <property name="accelerator">&lt;Alt&gt;p</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Volume Up</property>
            <property name="accelerator">&lt;Alt&gt;Up</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Volume Down</property>
            <property name="accelerator">&lt;Alt&gt;Down</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Rotate Device Screen</property>
            <property name="accelerator">&lt;Alt&gt;r</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Turn Device Screen Off</property>
            <property name="accelerator">&lt;Alt&gt;o</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Turn Device Screen On</property>
            <property name="accelerator">&lt;Alt&gt;&lt;Shift&gt;o</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Open Notifications</property>
            <property name="accelerator">&lt;Alt&gt;n</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Copy Device Clipboard</property>
            <property name="accelerator">&lt;Alt&gt;c</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Paste Computer Clipboard</property>
            <property name="accelerator">&lt;Alt&gt;v</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Stop Mirroring</property>
            <property name="accelerator">&lt;Alt&gt;q</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
