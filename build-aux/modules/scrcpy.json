{
    "name": "scrcpy",
    "buildsystem": "meson",
    "config-opts": [
        "-Dbuildtype=release",
        "-Dprebuilt_server=scrcpy-server",
        "-Dv4l2=false"
    ],
    "cleanup": [
        "/share/applications",
        "/share/bash-completion",
        "/share/man",
        "/share/zsh"
    ],
    "sources": [
        {
            "type": "archive",
            "url": "https://github.com/Genymobile/scrcpy/archive/refs/tags/v5.0.1.tar.gz",
            "sha256": "a24b996ac23d0f674d3237c00b39a97829d8acbe9e1657a6c216fd51ea488ee5",
            "x-checker-data": {
                "type": "json",
                "url": "https://api.github.com/repos/Genymobile/scrcpy/releases/latest",
                "version-query": ".tag_name",
                "url-query": "\"https://github.com/Genymobile/scrcpy/archive/refs/tags/\" + $version + \".tar.gz\""
            }
        },
        {
            "type": "file",
            "url": "https://github.com/Genymobile/scrcpy/releases/download/v5.0.1/scrcpy-server-v5.0.1",
            "sha256": "764eb6f79811d5211fe9df341120882ba9994c7a61b897d7bf3fb662e53bc536",
            "dest-filename": "scrcpy-server",
            "x-checker-data": {
                "type": "json",
                "url": "https://api.github.com/repos/Genymobile/scrcpy/releases/latest",
                "version-query": ".tag_name",
                "url-query": ".assets[] | select(.name == \"scrcpy-server-\" + $version) | .browser_download_url"
            }
        }
    ]
}
