{
    "name": "android-tools",
    "buildsystem": "simple",
    "build-commands": [
        "cmake -S . -B _build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH=/app -DANDROID_TOOLS_PATCH_VENDOR=OFF -DANDROID_TOOLS_USE_BUNDLED_FMT=ON -DANDROID_TOOLS_ADB_ENABLE_MDNS=OFF",
        "ninja -C _build adb",
        "install -Dm755 _build/vendor/adb /app/bin/adb"
    ],
    "sources": [
        {
            "type": "archive",
            "url": "https://github.com/nmeum/android-tools/releases/download/37.0.0p1/android-tools-37.0.0p1.tar.xz",
            "sha256": "2c6de1abe16b211c7d9f59276217e14fd9e0e18b20e331d3c84358f5dffd576e",
            "x-checker-data": {
                "type": "json",
                "url": "https://api.github.com/repos/nmeum/android-tools/releases/latest",
                "version-query": ".tag_name",
                "url-query": "\"https://github.com/nmeum/android-tools/releases/download/\" + $version + \"/android-tools-\" + $version + \".tar.xz\""
            }
        }
    ]
}
