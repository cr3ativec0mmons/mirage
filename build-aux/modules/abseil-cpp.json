{
    "name": "abseil-cpp",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_CXX_STANDARD=17",
        "-DCMAKE_POSITION_INDEPENDENT_CODE=ON",
        "-DABSL_PROPAGATE_CXX_STD=ON",
        "-DABSL_BUILD_TESTING=OFF",
        "-DBUILD_SHARED_LIBS=OFF"
    ],
    "cleanup": [
        "*"
    ],
    "sources": [
        {
            "type": "archive",
            "url": "https://github.com/abseil/abseil-cpp/releases/download/20260817.0/abseil-cpp-20260817.0.tar.gz",
            "sha256": "f7e05179df39c45434cad433f5783840bb3788ef322976f9138bc6b72b3a107d",
            "x-checker-data": {
                "type": "json",
                "url": "https://api.github.com/repos/abseil/abseil-cpp/releases/latest",
                "version-query": ".tag_name",
                "url-query": "\"https://github.com/abseil/abseil-cpp/releases/download/\" + $version + \"/abseil-cpp-\" + $version + \".tar.gz\""
            }
        }
    ]
}
