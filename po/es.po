#: data/tech.vitainside.mirage.gschema.xml.in:28
msgid "Video codec"
msgstr "Códec de vídeo"

#: data/tech.vitainside.mirage.gschema.xml.in:29
msgid "The codec used by the device to encode the screen"
msgstr "El códec que usa el dispositivo para codificar la pantalla"

#: data/tech.vitainside.mirage.gschema.xml.in:33
msgid "Maximum resolution"
msgstr "Resolución máxima"

#: data/tech.vitainside.mirage.gschema.xml.in:34
msgid ""
"Limit the largest dimension of the video, in pixels. 0 keeps the device "
"resolution."
msgstr ""
"Limitar la dimensión más grande del vídeo, en píxeles. 0 mantiene la "
"resolución del dispositivo."

#: data/tech.vitainside.mirage.gschema.xml.in:38
msgid "Maximum frame rate"
msgstr "Tasa de fotogramas máxima"

#: data/tech.vitainside.mirage.gschema.xml.in:39
msgid "Limit the frame rate of the screen capture. 0 means no limit."
msgstr ""
"Limitar la tasa de fotogramas de la captura de pantalla. 0 significa sin "
"límite."

#: data/tech.vitainside.mirage.gschema.xml.in:44
msgid "Video bit rate"
msgstr "Tasa de bits del vídeo"

#: data/tech.vitainside.mirage.gschema.xml.in:45
msgid "The video bit rate, in megabits per second"
msgstr "La tasa de bits del vídeo, en megabits por segundo"

#: data/tech.vitainside.mirage.gschema.xml.in:54
msgid "Hardware decoding"
msgstr "Decodificación por hardware"

#: data/tech.vitainside.mirage.gschema.xml.in:55
msgid "Decode the video with the GPU of the computer"
msgstr "Decodificar el vídeo con la GPU del equipo"

#: data/tech.vitainside.mirage.gschema.xml.in:61
msgid "Use a new virtual display"
msgstr "Usar una pantalla virtual nueva"

#: data/tech.vitainside.mirage.gschema.xml.in:62
msgid ""
"Create a separate display on the device instead of mirroring the main one "
"(Android 10 or later)"
msgstr ""
"Crear una pantalla independiente en el dispositivo en lugar de duplicar la "
"principal (Android 10 o posterior)"

#: data/tech.vitainside.mirage.gschema.xml.in:66
msgid "Virtual display resolution"
msgstr "Resolución de la pantalla virtual"

#: data/tech.vitainside.mirage.gschema.xml.in:67
msgid ""
"The resolution of the virtual display as WIDTHxHEIGHT, or empty to match the "
"main display"
msgstr ""
"La resolución de la pantalla virtual como ANCHOxALTO, o vacía para usar la "
"de la pantalla principal"

#: data/tech.vitainside.mirage.gschema.xml.in:72
msgid "Virtual display density"
msgstr "Densidad de la pantalla virtual"

#: data/tech.vitainside.mirage.gschema.xml.in:73
msgid ""
"The pixel density of the virtual display in dots per inch, or 0 to match the "
"main display"
msgstr ""
"La densidad de píxeles de la pantalla virtual en puntos por pulgada, o 0 "
"para usar la de la pantalla principal"

